# Local PostgreSQL + PostGIS (matches docker-compose.yml defaults)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tourguide
DB_USER=tourguide
DB_PASSWORD=tourguide123

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO Object Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# JWT Signing Key (must be Base64-encoded and at least 256 bits / 32 decoded bytes)
# Generate with: openssl rand -base64 32
JWT_SECRET=dG91ZG8tZGV2LWp3dC1zZWNyZXQta2V5LWNoYW5nZS1pbi1wcm9kdWN0aW9uLTIwMjY=

# Demo Seed Data (auto-seeds Izmir landmarks, routes, quests, badges, and demo user in dev)
SEED_DEMO_DATA=true

# AI Chat Provider: demo (DB-grounded local fallback) | ollama | gemini
AI_PROVIDER=demo
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=qwen3:8b
GEMINI_API_KEY=

# Optional Google Integrations
GOOGLE_VISION_API_KEY=
GOOGLE_PLACES_API_KEY=
